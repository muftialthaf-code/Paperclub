# Set real values in Railway Variables, never in source control.
APP_ORIGIN=https://paperclub-web-production.up.railway.app
BETTER_AUTH_URL=https://paperclub-web-production.up.railway.app
BETTER_AUTH_SECRET=
DATABASE_URL=
PORT=8080
NODE_ENV=production
# Google Cloud OAuth Web client. Redirect URI:
# https://paperclub-web-production.up.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified sender, e.g. Paperclub <hello@your-domain.example>
EMAIL_FROM=
# Choose Resend HTTPS delivery OR an SMTP provider.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Verified platform-owner email allowlist. Owner management also requires authenticator setup/unlock.
PLATFORM_OWNER_EMAILS=
