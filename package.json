{
  "name": "paperclub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "test": "tsx --test src/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "test:accounts": "tsx --test server/*.test.ts",
    "build:railway": "tsc -b && tsc -p tsconfig.railway.json && vite build && node scripts/build-railway.mjs",
    "start": "node dist/railway/index.mjs",
    "db:migrate:railway": "node dist/railway/migrate.mjs",
    "test:railway": "tsx --test server/railway/*.test.ts",
    "maintenance:railway": "node dist/railway/maintenance.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.2",
    "hono": "^4.11.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.12",
    "jsdom": "^31.0.0",
    "jsqr": "1.4.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
